# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=hms_core
DATABASE_URL=postgres://admin:password123@db:5432/hms_core

# Backend Configuration
PORT=3001
APP_ENV=dev
AUTH_REQUIRED=true
JWT_SECRET=change-me-dev
JWT_KID=v1
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_ROLE=admin
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
RATE_LIMIT_PER_MINUTE=60
LOGIN_LIMIT_PER_MINUTE=10
# Metrics endpoint exposure:
# - true (default in dev): public /metrics
# - false: only private network or proxy token header X-Metrics-Auth
METRICS_PUBLIC=true
# Optional shared secret expected in X-Metrics-Auth when /metrics is not public.
METRICS_AUTH_TOKEN=
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# For production APP_ENV=prod, COOKIE_DOMAIN must be set (e.g. hms.example.com)
COOKIE_DOMAIN=
