# Production environment example (do not commit real secrets)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hms_core
DATABASE_URL=postgres://admin:change-me-strong-db-password@db:5432/hms_core

PORT=3001
APP_ENV=prod
AUTH_REQUIRED=true

JWT_SECRET=change-me-with-at-least-32-chars
JWT_KID=v1

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_ROLE=admin

CORS_ORIGIN=https://app.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=example.com

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
RATE_LIMIT_PER_MINUTE=60
LOGIN_LIMIT_PER_MINUTE=10
METRICS_PUBLIC=false
# Recommended when scraping through auth proxy/load balancer:
METRICS_AUTH_TOKEN=change-me-metrics-proxy-token

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=hms-backend
